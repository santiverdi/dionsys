# Sincronización en la nube (Supabase). Copiá este archivo a .env.local y completá
# los valores. Sin estos valores la app funciona igual, pero SOLO con localStorage
# (sin compartir datos entre dispositivos).
#
# Dónde encontrarlos: supabase.com → tu proyecto → Project Settings → API
#   - Project URL  → VITE_SUPABASE_URL
#   - anon public  → VITE_SUPABASE_ANON_KEY
#
# En producción (Vercel): cargar estas dos variables en
#   Project Settings → Environment Variables (Production + Preview).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key
